# Optional overrides for scripts/deploy.sh and scripts/smoke-testnet.sh.
# Keys live in Stellar CLI identities (~/.config/stellar), never in this file.

# Identity that pays for and signs the deploy (created + Friendbot-funded on testnet).
STELLAR_IDENTITY=folder-deployer
# Identity that becomes the first admin (defaults to STELLAR_IDENTITY).
ADMIN_IDENTITY=folder-deployer
# RPC endpoint (defaults to the network's public RPC).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployment record the smoke test targets.
DEPLOYMENT=deployments/testnet.json
